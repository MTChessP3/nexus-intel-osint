// OSINT Threat Intelligence Platform - Database Schema
// Real IOC storage with full indexing and search capabilities

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== CORE INTELLIGENCE MODELS ====================

model IOC {
  id              String   @id @default(cuid())
  type            IOCType  // ip, domain, url, hash, email, cve
  value           String   @unique
  description     String?
  severity        Severity @default(MEDIUM)
  confidence      Int      @default(50) // 0-100
  status          IOCStatus @default(UNKNOWN)
  tags            String   @default("[]") // JSON array
  source          String?
  rawResponse     String?  // Store actual API response JSON
  firstSeen       DateTime @default(now())
  lastUpdated     DateTime @updatedAt
  
  // Relations
  analyses        Analysis[]
  alerts           Alert[]
  
  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([value])
  @@map("iocs")
}

model Analysis {
  id          String   @id @default(cuid())
  iocId       String
  ioc         IOC      @relation(fields: [iocId], references: [id], onDelete: Cascade)
  source      String   // Which API/source provided this
  sourceType  SourceType
  rawData     String   // Actual JSON response from source
  summary     String?  // AI-generated or extracted summary
  findings    String   @default("[]") // JSON array of findings
  verified    Boolean  @default(false)
  timestamp   DateTime @default(now())
  
  @@index([iocId])
  @@index([source])
  @@index([sourceType])
  @@map("analyses")
}

model Alert {
  id          String       @id @default(cuid())
  iocId       String?
  ioc         IOC?         @relation(fields: [iocId], references: [id], onDelete: SetNull)
  title       String
  description String
  severity    Severity     @default(HIGH)
  type        AlertType    @default(IOC_DETECTED)
  status      AlertStatus  @default(ACTIVE)
  rawData     String?      // Related external data
  actionTaken String?
  createdAt   DateTime     @default(now())
  resolvedAt  DateTime?
  
  @@index([status])
  @@index([severity])
  @@index([type])
  @@map("alerts")
}

model ThreatFeed {
  id          String   @id @default(cuid())
  feedName    String   // CISA, AbuseCH, MalwareBazaar, etc.
  feedType    FeedType
  entryTitle  String
  entryData   String   // JSON of the feed entry
  iocExtracted String? // Extracted IOCs from this entry
  fetchedAt   DateTime @default(now())
  publishedAt DateTime?
  
  @@index([feedName])
  @@index([feedType])
  @@map("threat_feeds")
}

model Report {
  id          String   @id @default(cuid())
  title       String
  type        ReportType
  content     String   // Full report in markdown/HTML
  format      String   @default("json") // json, pdf, csv
  iocsIncluded String  @default("[]") // Array of IOC IDs
  generatedAt DateTime @default(now())
  
  @@map("reports")
}

// ==================== ENUMS ====================

enum IOCType {
  IP
  DOMAIN
  URL
  HASH
  EMAIL
  CVE
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum IOCStatus {
  UNKNOWN
  BENIGN
  SUSPICIOUS
  MALICIOUS
}

enum SourceType {
  GEO_IP
  THREAT_INTEL
  DNS
  WHOIS
  MALWARE_ANALYSIS
  VULNERABILITY_DB
  REPUTATION
  AI_ANALYSIS
}

enum AlertType {
  IOC_DETECTED
  THREAT_FEED_MATCH
  VULNERABILITY_FOUND
  ANOMALY_DETECTED
  CORRELATION_ALERT
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  FALSE_POSITIVE
}

enum FeedType {
  RSS
  API
  CSV
  JSON
}

enum ReportType {
  EXECUTIVE_SUMMARY
  IOC_REPORT
  THREAT_BRIEFING
  INCIDENT_REPORT
  CORRELATION_ANALYSIS
}
