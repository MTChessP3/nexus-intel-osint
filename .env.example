# ===== NEXUS INTEL / MONITOR-THREAT Configuration =====
# Copy this file to .env and fill in your keys.
# Local development works without any keys (AI + KV fall back to demo/memory mode).

# ---- AI (OpenAI-compatible, defaults to Groq) ----
# Get a free key at https://console.groq.com/keys
AI_API_KEY=
GROQ_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2000

# ---- Persistence (Vercel KV / Upstash Redis) ----
# Create a KV store in the Vercel dashboard; the REST URL and token are auto-injected.
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Optional intelligence sources ----
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
